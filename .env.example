# GitHub Search API (optional; without token: 60 req/h, with token: 5000 req/h)
# Create at: https://github.com/settings/tokens (no scopes required for /search)
GITHUB_TOKEN=

# Bocha AI Search (https://bochaai.com)
BOCHA_API_KEY=

# Aliyun Bailian Web Search (https://bailian.console.aliyun.com/)
BAILIAN_API_KEY=

# Baidu Qianfan (https://console.bce.baidu.com/qianfan/)
# New bce-v3 API keys only need QIANFAN_API_KEY.
# QIANFAN_SECRET_KEY is kept for legacy API Key + Secret Key credentials.
QIANFAN_API_KEY=
QIANFAN_SECRET_KEY=

# TianAPI news (https://www.tianapi.com/)
TIANAPI_KEY=

# Tavily Search API (https://app.tavily.com/)
TAVILY_API_KEY=

# Qiniu Web Search (https://www.qiniu.com/)
QINIU_WEB_SEARCH_API_KEY=

# Optional LLM analysis provider.
# Any OpenAI-compatible chat endpoint can be used.
# MiniMax is supported directly through MINIMAX_*.
# If MINIMAX_BASE_URL contains "/anthropic", the chat call switches to the
# Anthropic Messages API (x-api-key + anthropic-version headers, /v1/messages).
# Otherwise it uses the OpenAI-compatible /chat/completions endpoint.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

# Other OpenAI-compatible providers can use OPENAI_*.
# Examples:
# - OpenAI: OPENAI_BASE_URL=https://api.openai.com/v1
# - DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com/v1
# - OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

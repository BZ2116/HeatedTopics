# HeatedTopics 最小配置
# 复制为 .env 后，填写一个 LLM、一个 embedding，以及需要的平台凭据。

# 1. LLM：支持 openai、deepseek、openrouter、ollama、gemini、
#    openai_compatible 等 provider。
HT_LLM_PROVIDER=openai_compatible
HT_LLM_API_KEY=
HT_LLM_BASE_URL=
HT_LLM_MODEL=

# 2. Embedding：支持 ollama、openai、openai_compatible、gemini、
#    openrouter、dashscope 等 provider。
HT_EMBEDDING_PROVIDER=ollama
HT_EMBEDDING_API_KEY=
HT_EMBEDDING_BASE_URL=
HT_EMBEDDING_MODEL=bge-m3

# 3. 平台和外部项目配置
ZHIHU_COOKIE=
LAST30DAYS_CLI_PATH=

# 4. 可选平台凭据：只在启用对应数据源时填写
GITHUB_TOKEN=
BOCHA_API_KEY=
BAILIAN_API_KEY=
QIANFAN_API_KEY=
QIANFAN_SECRET_KEY=
TIANAPI_KEY=
TAVILY_API_KEY=
QINIU_WEB_SEARCH_API_KEY=

# 5. Web Search MCP：默认使用 MiniMax Token Plan；可切换为 generic_mcp。
HT_WEB_SEARCH_PROVIDER=minimax_mcp
HT_WEB_SEARCH_MCP_COMMAND=uvx
HT_WEB_SEARCH_MCP_ARGS=--with fastmcp minimax-coding-plan-mcp -y
HT_WEB_SEARCH_MCP_TOOL=web_search
HT_WEB_SEARCH_MCP_PROVIDER_NAME=mcp_web_search
HT_WEB_SEARCH_MCP_ENV_JSON={}
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimaxi.com

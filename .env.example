# HeatedTopics 最小配置
# 复制为 .env 后，填写一个 LLM、一个 embedding，以及需要的平台凭据。

# 1. LLM：支持 openai、deepseek、openrouter、ollama、gemini、
#    openai_compatible 等 provider。
HT_LLM_PROVIDER=openai_compatible
HT_LLM_API_KEY=
HT_LLM_BASE_URL=
HT_LLM_MODEL=

# 2. Embedding：支持 ollama、openai、openai_compatible、gemini、
#    openrouter、dashscope 等 provider。
HT_EMBEDDING_PROVIDER=ollama
HT_EMBEDDING_API_KEY=
HT_EMBEDDING_BASE_URL=
HT_EMBEDDING_MODEL=bge-m3

# 3. 平台和外部项目配置
ZHIHU_COOKIE=
LAST30DAYS_CLI_PATH=

# 4. 可选平台凭据：只在启用对应数据源时填写
GITHUB_TOKEN=
BOCHA_API_KEY=
BAILIAN_API_KEY=
QIANFAN_API_KEY=
QIANFAN_SECRET_KEY=
TIANAPI_KEY=
TAVILY_API_KEY=
QINIU_WEB_SEARCH_API_KEY=
